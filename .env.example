# Local configuration only. Never commit .env or a real API key.
OPENAI_API_KEY=
ENTRY_MODEL=gpt-4o-mini
RELEVANCE_MODEL=gpt-4o-mini
TIMELINESS_MODEL=gpt-4o
ANSWER_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-large
VECTOR_DB_PATH=./data/vector-store
DEFAULT_COLLECTION=rag-default
REFERENCE_COLLECTION=rag-reference
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
APP_ENV=local
APP_REVISION=unknown
LOG_LEVEL=INFO
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mt-rag-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
LANGSMITH_TRACING_SAMPLING_RATE=1.0
